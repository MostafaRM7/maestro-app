{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maestro",
  "version": "0.1.0",
  "identifier": "com.maestroai.app",
  "build": {
    "beforeDevCommand": "node ../../scripts/stage-sidecar.mjs --debug && pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web && node ../../scripts/stage-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maestro",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/maestrod", "binaries/maestro-fake-agent"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["dmg", "appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "A local control center for CLI coding agents",
    "longDescription": "Maestro orchestrates installed CLI coding agents through a unified desktop control center.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
