{
  "schemaVersion": 1,
  "adapterContractVersion": 1,
  "cli": "codex-cli",
  "cliVersion": "0.146.0",
  "platform": {
    "os": "macos",
    "architecture": "arm64"
  },
  "transport": "stdio-jsonl",
  "structuredCommand": ["codex", "app-server", "--stdio"],
  "fallbackOrder": ["app-server", "exec-json", "pty-tui"],
  "experimentalApiEnabled": false,
  "testedReadOnlyMethods": ["account/read", "model/list", "thread/list"],
  "observedResponseOrder": ["1", "notification", "3", "2", "4"],
  "eofExitCode": 0,
  "malformedJson": {
    "reportedOn": "stderr",
    "connectionRemainedUsable": true
  },
  "vendorAcceptedFrameBytesAtLeast": 8388608,
  "maestroMaximumFrameBytes": 1048576,
  "generatedSchemaCounts": {
    "stableClientRequests": 90,
    "experimentalClientRequests": 127,
    "stableServerRequests": 10,
    "experimentalServerRequests": 11,
    "stableServerNotifications": 70,
    "experimentalServerNotifications": 70
  },
  "experimentalOnlyClientRequests": [
    "collaborationMode/list",
    "environment/add",
    "environment/info",
    "environment/status",
    "fuzzyFileSearch/sessionStart",
    "fuzzyFileSearch/sessionStop",
    "fuzzyFileSearch/sessionUpdate",
    "memory/reset",
    "mock/experimentalMethod",
    "process/kill",
    "process/resizePty",
    "process/spawn",
    "process/writeStdin",
    "remoteControl/client/list",
    "remoteControl/client/revoke",
    "remoteControl/disable",
    "remoteControl/enable",
    "remoteControl/pairing/start",
    "remoteControl/pairing/status",
    "remoteControl/status/read",
    "thread/backgroundTerminals/clean",
    "thread/backgroundTerminals/list",
    "thread/backgroundTerminals/terminate",
    "thread/decrement_elicitation",
    "thread/increment_elicitation",
    "thread/items/list",
    "thread/memoryMode/set",
    "thread/realtime/appendAudio",
    "thread/realtime/appendSpeech",
    "thread/realtime/appendText",
    "thread/realtime/listVoices",
    "thread/realtime/start",
    "thread/realtime/stop",
    "thread/search",
    "thread/searchOccurrences",
    "thread/settings/update",
    "thread/turns/list"
